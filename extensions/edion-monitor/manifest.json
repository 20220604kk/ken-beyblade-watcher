{
  "manifest_version": 3,
  "name": "陀螺監控・愛電王本機連接器",
  "version": "1.1.0",
  "minimum_chrome_version": "120",
  "description": "背景讀取官方商品 HTML；受限自動冷卻、不要求人工確認、不重整分頁、不匯出 Cookie、不下單。",
  "permissions": ["storage", "alarms", "scripting"],
  "host_permissions": ["https://www.edion.com/*", "https://edion.com/*", "http://127.0.0.1:3210/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "愛電王本機連接器", "default_popup": "popup.html" }
}
