# Discord 公開情報頻道：Funbox 與購物網站新品、庫存通知。
# 舊版 DISCORD_WEBHOOK_URL 仍可沿用；新設定建議使用下方的明確名稱。
DISCORD_PUBLIC_WEBHOOK_URL=

# Discord 私人管理頻道：訂單、付款資料與錯誤，不可使用公開頻道 Webhook。
DISCORD_PRIVATE_WEBHOOK_URL=

# M.M小舖公開補貨頻道：只傳送 M.M 新品與補貨通知。
# M.M小舖自動下單已退役；監控與公開通知仍會繼續運作。
DISCORD_MMTOY_WEBHOOK_URL=

# 公開 momo 待售商品看板（獨立唯讀頻道）
DISCORD_SALE_BOARD_WEBHOOK_URL=

# 狀態頻道自動改名需要 Discord Bot 的「管理頻道」權限
DISCORD_BOT_TOKEN=
DISCORD_STATUS_CHANNEL_ID=

# LINE（選用）：保留既有 LINE Messaging API 通知能力。
LINE_CHANNEL_ACCESS_TOKEN=

# 自動購買預設關閉；以下是舊版帳號匯入欄位，留空即可。
FUNBOX_BUY_EMAIL=
FUNBOX_BUY_PASSWORD=
ESLITE_BUY_ACCOUNT=
ESLITE_BUY_PASSWORD=

# X 日亞情報來源（選用）：也可在「日本拍賣」分頁輸入，將以本機加密方式保存。
X_API_BEARER_TOKEN=

# 上述欄位只供舊設定匯入；建議直接在控制台各平台分頁儲存一組加密帳密。

# 選用：你有權使用且可公開讀取的商品售價 Google 試算表。
# 不設定時不讀取任何預設試算表。不提供 Google 密碼或授權 token。
PRODUCT_CATALOG_SHEET_ID=
PRODUCT_CATALOG_SHEET_GID=0
